# El unico proceso que se asoma a internet.
#
# Caddy en vez de Nginx por una sola razon: saca y renueva el
# certificado de Let's Encrypt solo, sin cron ni certbot ni un dia en
# que alguien se olvido de renovar y la app de campo deja de funcionar
# —y sin certificado no hay service worker, ni camara, ni ubicacion, ni
# avisos: la app de campo simplemente no existe.
#
# Las direcciones salen del .env (seccion 71): DOMINIO es la de la
# consola (mycentauro.lat) y DOMINIO_CAMPO la de la app del personal de
# seguridad (appep.mycentauro.lat). Sin DOMINIO_CAMPO todo vive en
# DOMINIO, como antes.
#
# DOMINIO_CI (seccion 133) es la de la app del cliente de la Central de
# Inteligencia (ci.mycentauro.lat). Sin ella, la app vive en
# DOMINIO/ci/.

{
	# A donde escribe Let's Encrypt si un certificado esta por vencer y
	# no se pudo renovar. Es la unica forma de enterarse antes.
	email operaciones@centauro.lat
}

# www va a la consola. El registro A de www.{$DOMINIO} tiene que existir
# en Cloud DNS antes de levantar esto: sin el, Let's Encrypt no puede
# dar el certificado y Caddy lo reintenta en silencio (seccion 100).
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} 302
}

{$DOMINIO} {$DOMINIO_CAMPO} {$DOMINIO_CI} {
	encode zstd gzip

	# Lo mas que pesa una peticion. Las fotos ya se recortan a 3 o 4 MB
	# en la API; sin este tope, cualquiera sin sesion podia mandar
	# gigabytes a /auth/token y la API los cargaba en memoria antes de
	# rechazarlos (seccion 100).
	request_body {
		max_size 20MB
	}

	# Dos puertas y un solo servidor (seccion 71). mycentauro.lat es la
	# consola --Centauro Connect--, del personal administrativo y los
	# consultores; appep.mycentauro.lat es la app del personal de
	# seguridad --Proteccion Ejecutiva Connect App--. Cada una en su
	# direccion, para que su sesion, lo que guarda el navegador y la app
	# instalada en el telefono no se mezclen. Las dos hablan con la misma
	# API, cada una desde su direccion. 302 y no 301 en todos los saltos:
	# uno permanente se queda guardado en cada navegador para siempre.

	# En la del cliente de la Central (seccion 133), la raiz abre su app.
	# Va antes que la de campo: las dos son "no es la consola".
	# Con `expression` y no con `host`: sin DOMINIO_CI, `host` se queda
	# sin valor y Caddy no arranca.
	@ci_raiz {
		path /
		expression `"{$DOMINIO_CI}" != "" && {host} == "{$DOMINIO_CI}"`
	}
	redir @ci_raiz /ci/ 302

	# Y la pagina de la app de campo, desde la del cliente, a la suya.
	# Solo la pagina: la app del cliente carga de /app/ su hoja de
	# estilo, que es la misma.
	@ci_campo {
		path /app /app/ /app/index.html
		expression `"{$DOMINIO_CI}" != "" && "{$DOMINIO_CAMPO}" != "" && {host} == "{$DOMINIO_CI}"`
	}
	redir @ci_campo https://{$DOMINIO_CAMPO}{uri} 302

	# La app del cliente, desde la consola o la de campo, a la suya: su
	# sesion, su app instalada y sus avisos son de esa direccion.
	@fuera_ci {
		path /ci /ci/ /ci/index.html
		expression `"{$DOMINIO_CI}" != "" && {host} != "{$DOMINIO_CI}"`
	}
	redir @fuera_ci https://{$DOMINIO_CI}{uri} 302

	# En la de la app, la raiz abre la app.
	@campo_raiz {
		not host {$DOMINIO}
		path /
	}
	redir @campo_raiz /app/ 302

	# Y la pagina de la consola se abre en la suya. Solo la pagina: la
	# app carga de /consola/ su api.js y su idioma.js, y esos se sirven
	# aqui mismo --un modulo que salta a otra direccion no carga--.
	@campo_consola {
		not host {$DOMINIO}
		path /consola /consola/ /consola/index.html
	}
	redir @campo_consola https://{$DOMINIO}{uri} 302

	# En la de la consola, la app se manda a la suya: la app instalada y
	# sus avisos son de la direccion donde se instalo, y tiene que ser
	# una sola. Sin DOMINIO_CAMPO no hay a donde mandarla y se queda.
	@consola_app {
		host {$DOMINIO}
		path /app /app/*
		expression `"{$DOMINIO_CAMPO}" != ""`
	}
	redir @consola_app https://{$DOMINIO_CAMPO}{uri} 302

	# La IP real del cliente. Sin esto el registro de auditoria guarda la
	# IP del proxy para todos, y el limite de intentos fallidos cuenta a
	# toda la empresa como una sola persona.
	reverse_proxy api:8000 {
		header_up X-Real-IP {remote_host}
	}

	header {
		# Solo https, tambien en las visitas siguientes.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Hacia otros sitios solo sale el dominio, nunca la ruta (seccion
		# 132). Estaba en "same-origin", que no manda nada, y Google
		# rechaza asi la llave del mapa interactivo: esa llave esta
		# limitada a mycentauro.lat y Google lo comprueba con este dato.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Que version corre no es asunto de nadie.
		-Server
	}

	# El service worker de la app de campo tiene que poder controlar
	# /app/ y nada mas. Se sirve desde ahi, asi que no hace falta
	# ampliarle el alcance; esta linea solo evita que un cache
	# intermedio se quede con una version vieja del trabajador, que es
	# como una app se queda congelada sin que nadie entienda por que.
	@sw path /app/sw.js /ci/sw.js
	header @sw Cache-Control "no-cache"

	# El disparador de Pegasus lleva su secreto en la ruta (seccion 101):
	# cada aviso dejaba `POST /gps/pegasus/aviso/<secreto>` en claro en el
	# registro de acceso, diez archivos de 20 MB que cualquiera con el
	# disco puede leer. Ese aviso no se escribe. La API tapa el suyo en
	# `main.py`.
	@pegasus path /gps/pegasus/aviso/*
	log_skip @pegasus

	log {
		output file /data/acceso.log {
			roll_size 20mb
			roll_keep 10
		}
	}
}
